<TEI xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>Manual Lemmatization and Grammatical Annotation 20 lines</title>
        <editor>Ace Long</editor>
      </titleStmt>  
      <sourceDesc>
        <p>Excerpt from King Louis XVI, Letter to the Assemblée Nationale (31 December 1791), Zweig MS 169</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <p>
        <w lemma="à" pos="ADP"><choice><orig>A</orig><reg>À</reg></choice></w>
        
        <w lemma="le" pos="DET" msd="Definite=Def|Number=Sing|PronType=Art">l'</w><w lemma="assemblée" pos="NOUN" msd="Number=Sing">Assemblée</w>
        
        <w lemma="Nationale" pos="PROPN" msd="Gender=Fem|Number=Sing">Nationale</w>
        
        <w lemma="je" pos="PRON" msd="Number=Sing|Person=1">J'</w>
        <w lemma="avoir" pos="AUX" msd="Mood=Ind|Number=Sing|Person=1|Tense=Pres|VerbForm=Fin">ai</w>

        <w lemma="changecharger" pos="VERB" msd="Gender=Masc|Number=Sing|Tense=Past|VerbForm=Part">Change<choice><orig>charge</orig><reg resp="#gemini">chargé</reg></choice></w>
        
        <w lemma="le" pos="DET" msd="Definite=Def|Gender=Masc|Number=Sing|PronType=Art">le</w>

        <w lemma="ministre" pos="NOUN" msd="Gender=Masc|Number=Sing">Ministre</w>
        
        <w lemma="de" pos="ADP" msd="Definite=Def|Number=Plur|PronType=Art">des</w>
        
        <w lemma="affaire" pos="NOUN" msd="Gender=Fem|Number=Plur">affaires</w>
        
        <w lemma="étrangèresétrangère" pos="ADJ" msd="Number=Plur">étrangères<choice><orig>etrangeres</orig><reg resp="#gemini">étrangères</reg></choice></w>
        
        <w lemma="messieursmessieur" pos="ADJ" msd="Gender=Masc|Number=Plur">Messieurs<choice><abbr>MM</abbr><expan resp="#gemini">Messieurs</expan></choice></w>

        <w lemma="de" pos="ADP">de</w>

        <w lemma="vous" pos="PRON" msd="Number=Plur|Person=2">vous</w>

        <w lemma="communiquer" pos="VERB" msd="Mood=Ind|Number=Plur|Person=2|Tense=Pres|VerbForm=Fin">communiquez</w>
        
      </p>
    </body>
  </text>
