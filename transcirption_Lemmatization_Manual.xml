        <w lemma="le" pos="DET" msd="Definite=Def|Gender=Masc|Number=Sing|PronType=Art">l'</w><w lemma="Empereur" pos="PROPN" msd="Gender=Masc|Number=Sing">Empereur</w><pc>,</pc>
