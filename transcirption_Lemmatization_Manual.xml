        <w lemma="demander" pos="VERB" msd="Tense=Past|VerbForm=Part"><choice><orig>demander</orig><reg>demandé</reg></choice></w>
        <w lemma="que" pos="ADV">que</w>
        <w lemma="de" pos="ADP">de</w>
